# nibe-hub settings for tools/run_local.sh (Apple Containers).
# Copy to .env and fill in; .env is git-ignored.
#
# Format: one KEY=value per line, no quotes, no spaces around "=", and no comments after a
# value (the whole rest of the line is the value). Lines starting with # are ignored.
#
# run_local.sh gives each process only its own lines:
#   collector:  NIBE_*, DB_PATH, RUST_LOG
#   MCP server: MCP_*, TZ_NAME, DB_PATH, RUST_LOG

# --- Collector: the heat pump (menu 7.5.15 on the pump shows the API settings) ---

# Address of the pump's local REST API, e.g. https://192.168.1.50:8443
NIBE_URL=https://<pump-ip>:8443
# User name and password set in menu 7.5.15
NIBE_USER=
NIBE_PASS=

# SHA-256 fingerprint of the pump's self-signed certificate. The collector sends the pump
# password only to the server with this certificate. Read it with:
#   openssl s_client -connect <pump-ip>:8443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256 -subject
# and paste the part after "Fingerprint=" (colons are fine).
# Whatever answers at that moment gets pinned, so read it over a network you trust, and
# compare it with a second reading from another device (see README, "The pump's TLS certificate").
# Leaving this line empty is an error; remove the line only if NIBE_URL has a CA-signed certificate.
NIBE_TLS_FINGERPRINT=

# Optional: poll interval in seconds (default 60, minimum 10)
#NIBE_POLL_SECS=60

# Optional: points to poll more often via /points/<id>, e.g. compressor and unit power.
# Verified on firmware 4.6.x. Each id must exist on the pump: ids it doesn't report are
# skipped with a warning at startup (check the log for typos).
#NIBE_FAST_IDS=1801,22130
#NIBE_FAST_SECS=10

# Optional, for a quick test only: turn certificate verification off.
# Cannot be combined with NIBE_TLS_FINGERPRINT.
#NIBE_INSECURE_TLS=true

# --- MCP server ---

# Bearer token for Claude; run_local.sh refuses to start without one.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=

# Optional: time zone for timestamps and day buckets (default Europe/Amsterdam)
#TZ_NAME=Europe/Amsterdam

# --- Both ---

# Optional: log level (default info); "debug" logs every poll
#RUST_LOG=info
