# nibe-hub settings for tools/run_local.sh (Apple Containers).
# Copy to .env and fill in; .env is git-ignored. One KEY=value per line, no quotes,
# no spaces around "=". Lines starting with # are ignored.
# run_local.sh gives the collector only the NIBE_* lines and the MCP server only the MCP_* lines.

# --- Collector: the heat pump (menu 7.5.15 on the pump shows the API settings) ---

# Address of the pump's local REST API, e.g. https://192.168.1.50:8443
NIBE_URL=https://<pump-ip>:8443
# User name and password set in menu 7.5.15
NIBE_USER=
NIBE_PASS=

# SHA-256 fingerprint of the pump's self-signed certificate. Read it with:
#   openssl s_client -connect <pump-ip>:8443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
# and paste the part after "=" (colons are fine).
NIBE_TLS_FINGERPRINT=

# Optional: poll interval in seconds (default 60, minimum 10)
#NIBE_POLL_SECS=60

# Optional: points to poll more often via /points/<id>, e.g. compressor and unit power.
# Test the endpoint first (see README, "Still to verify on the real pump").
#NIBE_FAST_IDS=1801,22130
#NIBE_FAST_SECS=10

# Optional, for a quick test only: turn certificate verification off.
# Cannot be combined with NIBE_TLS_FINGERPRINT.
#NIBE_INSECURE_TLS=true

# --- MCP server ---

# Bearer token for Claude. Generate one with: openssl rand -hex 32
MCP_TOKEN=

# Optional: time zone for timestamps and day buckets (default Europe/Amsterdam)
#TZ_NAME=Europe/Amsterdam

# --- Both ---

# Optional: log level (default info); "debug" logs every poll
#RUST_LOG=info
